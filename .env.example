# Copy to .env and fill in. NEVER commit .env.

# Key for the Gemini API (hosted Gemma 4). Get it from the hackathon Starter Kit / Google AI Studio.
GEMINI_API_KEY=your-key-here

# Gemma 4 model ID (the one line that decides which model is used). Options from the Starter Kit:
#   gemma-4-26b-a4b-it   (default)
#   gemma-4-31b-it
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# Optional: raises the GitHub API rate limit when triaging public PR URLs. Read-only, no scopes needed.
GITHUB_TOKEN=

# Optional limits
MAX_DIFF_CHARS=12000
